# Python
__pycache__/
*.pyo
*.pyd
.venv/
venv/

# Все модули открыты (.py) — компилированные .pyc не коммитим
*.pyc
*.pyc.bak

# Внутренняя документация и инструкции (ADR, архитектура, заметки) — не публикуем
docs/

# Пользовательские стратегии MBR-CSV — локально (папка и README трекаются)
strategies/*.csv

# Claude Code + внутренние инструкции (CLAUDE.md) — целиком локально, не в репозиторий
.claude/

# Секреты / профили игрока (аккаунты, статы, куки)
profiles/
*.env
.env
.env.*
!.env.example

# Отладочные/рабочие кадры — теперь складываются в debug/ (см. paths.debug_path)
/debug/
# Подстраховка: любые png в КОРНЕ проекта — отладочные, не коммитим
# (эталоны лежат в Templates/, attacks/ — они в подпапках и сюда не попадают)
/*.png
/treasure_event
debug_match/

# Большое дерево зависимостей (2 ГБ) — не коммитим, ставим через requirements
runtime/

# Логи / БД
*.log
logs/
*.sqlite
*.db

# IDE
.idea/
.vscode/

# Пользовательский конфиг бота — рантайм-состояние (пишется GUI). Шаблон: settings.example.json
/settings.json
